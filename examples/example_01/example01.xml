<?xml version="1.0" encoding="UTF-8"?>

<Problem name="example01" version="0.1">

    <!-- =========================================================
         GENERAL
         ========================================================= -->
    <General>
        <!-- Unit system used by the whole problem -->
        <Units>
            <Length>m</Length>
            <Force>N</Force>
            <Time>s</Time>
        </Units>

        <!-- 2D formulation -->
        <Dimension>2D</Dimension>
        <Formulation>plane_strain</Formulation>
    </General>


    <!-- =========================================================
         MESH
         Element type and connectivity are read directly from Gmsh.
         No need to specify Quad4 / Tri3 here.
         ========================================================= -->
    <Mesh>
        <File>example01.msh</File>
        <Format>gmsh</Format>
    </Mesh>


    <!-- =========================================================
         MATERIALS

         The "region" attribute refers to a Gmsh Physical Surface.
         The "model" attribute selects the constitutive model.

         Examples of model names planned for the solver:
             LinearElastic
             MohrCoulomb
             ModifiedCamClay
             BarcelonaBasicModel
         ========================================================= -->
    <Materials>

        <Material id="1"
                  name="soil1"
                  region="soil1"
                  model="LinearElastic">

            <!-- Parameters for Linear Elastic model -->
            <Parameters>
                <E>30000.0</E>
                <nu>0.30</nu>
            </Parameters>

        </Material>
    </Materials>


    <!-- =========================================================
         BOUNDARY CONDITIONS

         "group" refers to a Gmsh Physical Curve / Physical Point.

         fixed = -1 internally
         free  =  0 internally

         The XML uses descriptive words rather than numerical flags.
         The parser can convert:
             fixed -> -1
             free  ->  0
         ========================================================= -->
    <BoundaryConditions>

        <DisplacementBoundary name="base_fix"
                              group="bottomfix">
            <ux>fixed</ux>
            <uy>fixed</uy>
        </DisplacementBoundary>

    </BoundaryConditions>


    <!-- =========================================================
         LOADS

         "load" is the Physical Curve defined in Gmsh.
         For a boundary curve, traction is usually more natural
         than manually assigning the same nodal force to every node.
         ========================================================= -->
    <Loads>

        <BoundaryLoad name="top_load"
                      group="load"
                      type="traction">

            <tx>0.0</tx>
            <ty>-1000.0</ty>

        </BoundaryLoad>

    </Loads>


    <Analysis>

        <Type>static</Type>
        <Procedure>linear</Procedure>

        <!-- Gravity can be activated later -->
        <Gravity enabled="false">
            <gx>0.0</gx>
            <gy>-9.81</gy>
        </Gravity>

    </Analysis>


    <!-- =========================================================
         SOLVER SETTINGS
         ========================================================= -->
    <Solver>

        <LinearSolver>direct</LinearSolver>

        <!-- Used when nonlinear/plastic analysis is implemented -->
        <NonlinearSolver>
            <Method>NewtonRaphson</Method>
            <MaxIterations>50</MaxIterations>
            <Tolerance>1.0e-6</Tolerance>
        </NonlinearSolver>

    </Solver>


    <!-- =========================================================
         OUTPUT
         ========================================================= -->
    <Output>

    <!-- Main output for ParaView -->
    <VTK enabled="false">

      <!-- Relative to this XML file -->
      <Directory>results</Directory>

      <BaseName>example01</BaseName>

      <!-- Keep the exact integration-point database -->
      <WriteGaussPoints>true</WriteGaussPoints>

    </VTK>

    <!-- Optional quick/debug plot -->
    <Matplotlib enabled="true"/>

    <!-- Used only when Matplotlib is enabled -->
    <Displacement>uy</Displacement> <!-- Select "ux", "uy", or "|u|" to plot the displacement-->
    <DeformationScale>1.0</DeformationScale>

    <!-- Optional console benchmark/debug report -->
    <GaussPointResults enabled="false">
      <ElementID>0</ElementID>
      <GaussPoint>all</GaussPoint>
    </GaussPointResults>

  </Output>

</Problem>
