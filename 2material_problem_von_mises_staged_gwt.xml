<?xml version="1.0" encoding="UTF-8"?>

<Problem name="2material_test" version="0.1">

  <General>
    <Units>
      <Length>m</Length>
      <Force>kN</Force>
      <Time>s</Time>
    </Units>
    <Dimension>2D</Dimension>
    <Formulation>plane_strain</Formulation>
  </General>

  <Mesh>
    <File>2trimaterial.msh</File>
    <Format>gmsh</Format>
  </Mesh>

  <Materials>

    <Material id="1"
              name="upper_soil"
              region="soil1"
              model="VonMises">

      <Parameters>
        <E>10000.0</E>
        <nu>0.30</nu>
        <density>1800.0</density>
        <yield_stress>800.0</yield_stress>
        <hardening_modulus>2500.0</hardening_modulus>
      </Parameters>

    </Material>

    <Material id="2"
              name="lower_soil"
              region="soil2"
              model="VonMises">

      <Parameters>
        <E>20000.0</E>
        <nu>0.30</nu>
        <density>1900.0</density>
        <yield_stress>1200.0</yield_stress>
        <hardening_modulus>4000.0</hardening_modulus>
      </Parameters>

    </Material>

  </Materials>


  <Groundwater enabled="true" name="initial_gwt" type="horizontal">
    <UnitWeightWater>9.81</UnitWeightWater>
    <Elevation>1.50</Elevation>
  </Groundwater>

  <BoundaryConditions>

    <DisplacementBoundary
        name="base_fix"
        group="bottomfix">

      <ux>fixed</ux>
      <uy>fixed</uy>

    </DisplacementBoundary>

  </BoundaryConditions>

  <Loads>

    <BoundaryLoad
        name="top_load"
        group="load"
        type="traction">

      <tx>0.0</tx>
      <ty>1000.0</ty>

      <TimeFunction type="constant"/>

    </BoundaryLoad>

  </Loads>

  <Analysis>

    <Type>static</Type>
    <Procedure>nonlinear</Procedure>

    <LoadSteps>20</LoadSteps>

    <Gravity enabled="false">
      <gx>0.0</gx>
      <gy>-9.81</gy>
    </Gravity>

  </Analysis>

  <Solver>

    <LinearSolver>direct</LinearSolver>

    <NonlinearSolver>
      <Method>NewtonRaphson</Method>
      <MaxIterations>30</MaxIterations>
      <Tolerance>1.0e-8</Tolerance>
    </NonlinearSolver>

  </Solver>


  <Stages>

    <!-- Stage 0: establish self-weight equilibrium -->
    <Stage id="0" name="Gravity loading">

      <Procedure>nonlinear</Procedure>
      <LoadSteps>10</LoadSteps>

      <Gravity enabled="true">
        <gx>0.0</gx>
        <gy>-9.81</gy>
      </Gravity>

      <!-- No BoundaryLoad is active yet. -->

    </Stage>

    <!-- Stage 1: retain gravity and add the top traction -->
    <Stage id="1" name="Traction loading">

      <Procedure>nonlinear</Procedure>
      <LoadSteps>20</LoadSteps>

      <!-- Gravity is omitted intentionally. It remains active from Stage 0. -->
      <ActivateLoads>
        <Load name="top_load"/>
      </ActivateLoads>

    </Stage>

  </Stages>

  <Output>

    <!-- Main output for ParaView -->
    <VTK enabled="true">

      <!-- Relative to this XML file -->
      <Directory>results</Directory>

      <BaseName>2material_von_mises_staged_gwt</BaseName>

      <!-- Keep the exact integration-point database -->
      <WriteGaussPoints>true</WriteGaussPoints>

    </VTK>

    <!-- Optional quick/debug plot -->
    <Matplotlib enabled="true"/>

    <!-- Used only when Matplotlib is enabled -->
    <Displacement>|u|</Displacement>
    <DeformationScale>1.0</DeformationScale>

    <!-- Optional console benchmark/debug report -->
    <GaussPointResults enabled="false">
      <ElementID>0</ElementID>
      <GaussPoint>all</GaussPoint>
    </GaussPointResults>

  </Output>

</Problem>
